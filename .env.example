# Class AI — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
#
# The local AI service in ai-service/ reads this same file, so the Supabase
# values and the AI settings below live in one place.

# Supabase project URL. Read by the server; public by design.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Sent from the browser as the storage gateway's apikey when
# uploading audio to a signed URL. Safe to expose: RLS is enabled with no
# policies and the audio bucket has no policies, so this key on its own grants
# no read or write access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY — never expose to the browser. Bypasses
# RLS, and is what every database read/write and every signed URL goes through.
# The local AI service uses it too, which is why that service must stay bound to
# localhost.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Local AI service (ai-service/)
# ---------------------------------------------------------------------------
# Transcription and analysis run on this machine, so there is no AI API key.

# Where the Next.js app reaches the service. Defaults to http://127.0.0.1:8001.
AI_SERVICE_URL=

# Optional shared secret. When set here, the service requires it on every
# request. Leave empty for a single-machine setup.
AI_SERVICE_TOKEN=

# faster-whisper. `small` is the balance point on a 6 GB card; `medium` is more
# accurate and slower. Set WHISPER_DEVICE=cpu and WHISPER_COMPUTE_TYPE=int8 on a
# machine without an NVIDIA GPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Ollama. The model must already be pulled (`ollama pull llama3.2:3b`).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Context window for the analysis request, and the transcript length that has to
# fit inside it. Raise both together on a card with more VRAM.
OLLAMA_NUM_CTX=8192
MAX_TRANSCRIPT_CHARS=24000
